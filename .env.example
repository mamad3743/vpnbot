# ---- Telegram ----
BOT_TOKEN=123456789:AAAA-your-bot-token-from-BotFather
# آیدی عددی ادمین‌ها، با کاما جدا کن (آیدی عددی رو از @userinfobot بگیر)
ADMIN_IDS=111111111,222222222
# یوزرنیم کانال‌هایی که عضویت اجباریه، با کاما جدا کن. ربات باید ادمین این کانال‌ها باشه.
FORCE_JOIN_CHANNELS=@your_channel1,@your_channel2

# ---- پنل PasarGuard ----
PANEL_URL=https://your-panel-domain.com
PANEL_USERNAME=admin
PANEL_PASSWORD=your-strong-password
# اختیاری: شناسه گروه(های) پنل که کاربر جدید بهشون اضافه بشه، با کاما جدا کن
PANEL_GROUP_IDS=

# ---- پرداخت کارت به کارت ----
CARD_NUMBER=6037-XXXX-XXXX-XXXX
CARD_HOLDER=نام و نام خانوادگی
CURRENCY=تومان

# ---- اکانت تست رایگان ----
TRIAL_DAYS=1
TRIAL_GB=1

# ---- دیتابیس ----
DB_PATH=data/bot.db
