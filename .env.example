# These are the ONLY two things you might ever set as Railway variables.
# Everything else (bot token, admin id, panel credentials, force-join
# channels, payment card, trial size, mini-app color...) is entered through
# the /install page the first time you open your domain, and can be changed
# any time after that from inside the bot's "⚙️ پنل مدیریت" menu.

# Railway sets this automatically — you usually don't need to set it yourself.
PORT=8080

# Where the SQLite database file lives. Keep the default and mount a
# Railway Volume at /app/data so it survives redeploys.
DB_PATH=data/bot.db
